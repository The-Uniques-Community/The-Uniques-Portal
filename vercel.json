{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "index.js"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/api/:match*",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/upload",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/upload/:match*",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/auth/password-reset/:match*",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/auth/password-reset",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/auth/google/:match*",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/auth/google",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/auth/:endpoint(emaillogin|get_user|verify_user|verify_role|logout)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/:match*",
      "destination": {
        "service": "app"
      }
    }
  ]
}
