{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "index.js"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/upload/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/auth/password-reset/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/auth/(google.*|emaillogin|get_user|verify_user|verify_role|logout)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/((?!assets/|favicon|icons|projects/).*)",
      "destination": {
        "service": "app",
        "path": "/index.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
