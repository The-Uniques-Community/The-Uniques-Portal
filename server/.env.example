# Server Environment Variables Template
PORT=5001
MONGODB_URI=mongodb://localhost:27017/uniques_portal
DB_NAME=uniques_portal
JWT_SECRET=your_jwt_secret_key_here

# Frontend URLs for CORS
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
# Comma-separated list of additional allowed CORS origins (optional runtime override)
ALLOWED_ORIGINS=https://the-uniques-portal.vercel.app,https://theuniquesportal.vercel.app

# Email / Nodemailer
EMAIL_USER=
EMAIL_PASS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/auth/google/callback

# Google Service Account (JSON string)
GOOGLE_SERVICE_ACCOUNT=
